# Optional. No .env is needed to run the default offline mode.
LAB_PORT=8765
# Fill all three only when enabling model mode in the UI.
LAB_LLM_BASE_URL=
LAB_LLM_MODEL=
LAB_LLM_API_KEY=

# Optional pretrained embedding index. Empty = offline BM25/LSA.
LAB_EMBED_BASE_URL=
LAB_EMBED_MODEL=
LAB_EMBED_API_KEY=
# Optional public Python package index for Docker builds; no credentials.
LAB_PIP_INDEX_URL=https://pypi.org/simple

# Optional D02 MLflow metadata tracking (default workflow does not require it).
LAB_MLFLOW_URL=
LAB_MLFLOW_EXPERIMENT=engineering-practice-lab
LAB_MLFLOW_TOKEN=
